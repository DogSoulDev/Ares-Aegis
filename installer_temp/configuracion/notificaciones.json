        "teams": {
          "url": "https://empresa.webhook.office.com/...",
          "timeout_segundos": 15
        }
      },
      "formato": "json",
      "severidades": ["critico", "alto"]
    }
  },
  "plantillas_mensajes": {
    "critico": {
      "asunto": "[CRÍTICO] {sistema} - {evento} en {hostname}",
      "mensaje": "ALERTA CRÍTICA DETECTADA\n\nSistema: {sistema}\nEvento: {evento}\nHost: {hostname}\nFecha: {timestamp}\nDescripción: {descripcion}\nAcciones realizadas: {acciones}\n\nRequiere atención inmediata.",
      "color": "#FF0000",
      "icono": "🚨"
    },
    "alto": {
      "asunto": "[ALTO] {sistema} - {evento} en {hostname}",
      "mensaje": "Alerta de alta prioridad\n\nSistema: {sistema}\nEvento: {evento}\nHost: {hostname}\nFecha: {timestamp}\nDescripción: {descripcion}\nAcciones realizadas: {acciones}",
      "color": "#FF8C00",
      "icono": "⚠️"
    },
    "medio": {
      "asunto": "[MEDIO] {sistema} - {evento} en {hostname}",
      "mensaje": "Alerta de prioridad media\n\nSistema: {sistema}\nEvento: {evento}\nHost: {hostname}\nFecha: {timestamp}\nDescripción: {descripcion}",
      "color": "#FFD700",
      "icono": "⚡"
    },
    "bajo": {
      "asunto": "[BAJO] {sistema} - {evento} en {hostname}",
      "mensaje": "Información de seguridad\n\nSistema: {sistema}\nEvento: {evento}\nHost: {hostname}\nFecha: {timestamp}\nDescripción: {descripcion}",
      "color": "#32CD32",
      "icono": "ℹ️"
    },
    "info": {
      "asunto": "[INFO] {sistema} - {evento}",
      "mensaje": "Información del sistema\n\nSistema: {sistema}\nEvento: {evento}\nFecha: {timestamp}\nDescripción: {descripcion}",
      "color": "#87CEEB",
      "icono": "📋"
    }
  },
