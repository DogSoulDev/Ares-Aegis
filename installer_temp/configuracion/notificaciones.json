{
  "metadata": {
    "version": "3.0.0",
    "sistema": "Ares Aegis Notificaciones",
    "fecha_actualizacion": "2025-01-05T12:00:00Z",
    "plataforma": "Linux/Debian/Kali",
    "descripcion": "Sistema de notificaciones para Ares Aegis en entornos Linux",
    "idioma": "español",
    "compatibilidad": "Ares Aegis 3.0+"
  },
  "configuracion_global": {
    "habilitado": true,
    "modo_silencioso": false,
    "zona_horaria": "Europe/Madrid",
    "formato_fecha": "DD/MM/YYYY HH:mm:ss",
    "limite_velocidad": {
      "max_notificaciones_minuto": 15,
      "max_notificaciones_hora": 120,
      "periodo_enfriamiento_segundos": 60
    },
    "filtros": {
      "ignorar_duplicados": true,
      "ventana_duplicados_minutos": 10,
      "horario_activo": {
        "habilitado": false,
        "inicio": "08:00",
        "fin": "20:00",
        "dias_laborales": true
      }
    }
  },
  "canales_activos": {
    "syslog": {
      "habilitado": true,
      "prioridad": 1,
      "facility": "local0",
      "servidor": "localhost",
      "puerto": 514,
      "protocolo": "udp",
      "formato": "RFC3164",
      "severidades": ["critico", "alto", "medio", "bajo", "info"]
    },
    "archivo_log": {
      "habilitado": true,
      "prioridad": 2,
      "ruta": "/var/log/ares-aegis/notificaciones.log",
