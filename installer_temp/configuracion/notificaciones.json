        "habilitada": true,
        "tamaño_max_mb": 50,
        "archivos_historicos": 7,
        "compresion": true
      },
      "formato": "json",
      "severidades": ["critico", "alto", "medio", "bajo", "info"]
    },
    "email": {
      "habilitado": false,
      "prioridad": 3,
      "servidor_smtp": {
        "host": "smtp.empresa.com",
        "puerto": 587,
        "seguridad": "starttls",
        "autenticacion": true,
        "usuario": "ares-aegis@empresa.com",
        "timeout_segundos": 30
      },
      "configuracion": {
        "remitente": "Ares Aegis <ares-aegis@empresa.com>",
        "formato": "html",
        "adjuntar_logs": false,
        "firma_automatica": true
      },
      "severidades": ["critico", "alto"]
    },
    "webhook": {
      "habilitado": false,
      "prioridad": 4,
      "endpoints": {
        "slack": {
          "url": "https://hooks.slack.com/services/...",
          "canal": "#seguridad",
          "usuario": "Ares Aegis",
          "timeout_segundos": 15
