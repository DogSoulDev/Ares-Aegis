#!/bin/bash
# postinst script para ares-aegis
# Configuración post-instalación para Kali Linux

set -e

case "$1" in
    configure)
        echo "🛡️ Configurando Ares Aegis para Kali Linux..."
        
        # Crear directorio de aplicación
        mkdir -p /opt/ares-aegis
        mkdir -p /usr/share/applications
        mkdir -p /usr/share/pixmaps
        mkdir -p /usr/bin
        
        # Copiar archivos principales
        cp -r /usr/local/lib/python3.*/dist-packages/ares_aegis/* /opt/ares-aegis/ 2>/dev/null || true
        
        # Copiar iconos
        if [ -f "/opt/ares-aegis/recursos/AresAegis.png" ]; then
            cp /opt/ares-aegis/recursos/AresAegis.png /usr/share/pixmaps/ares-aegis.png
        fi
        
        if [ -f "/opt/ares-aegis/recursos/aresIcon.png" ]; then
            cp /opt/ares-aegis/recursos/aresIcon.png /usr/share/pixmaps/ares-aegis-icon.png
        fi
        
        # Crear script de lanzamiento
        cat > /usr/bin/ares-aegis << 'EOF'
#!/bin/bash
# Ares Aegis - Launcher Script para Kali Linux

# Verificar si se está ejecutando como root
if [ "$EUID" -ne 0 ]; then
    # Intentar ejecutar con pkexec (interfaz gráfica para sudo)
    if command -v pkexec >/dev/null 2>&1; then
        exec pkexec /usr/bin/python3 /opt/ares-aegis/main.py "$@"
    # Si no hay pkexec, usar sudo
    elif command -v sudo >/dev/null 2>&1; then
        echo "🔐 Ares Aegis requiere permisos de root para funcionalidad completa"
        exec sudo /usr/bin/python3 /opt/ares-aegis/main.py "$@"
    else
        echo "❌ Error: Se requieren permisos de administrador"
        echo "Por favor ejecuta: sudo ares-aegis"
        exit 1
    fi
else
    # Ya somos root, ejecutar directamente
    exec /usr/bin/python3 /opt/ares-aegis/main.py "$@"
fi
EOF
        
        # Hacer ejecutable el launcher
        chmod +x /usr/bin/ares-aegis
        
        # Crear entrada del menú de aplicaciones
        cat > /usr/share/applications/ares-aegis.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Name=Ares Aegis
Comment=Sistema de Ciberseguridad Avanzado para Kali Linux
Comment[es]=Suite completa de herramientas de ciberseguridad y pentesting
Exec=ares-aegis
Icon=ares-aegis
Terminal=false
Type=Application
Categories=Security;Network;System;
Keywords=security;cybersecurity;pentesting;vulnerability;scanner;kali;
StartupNotify=true
StartupWMClass=Ares Aegis
MimeType=
EOF
        
        # Establecer permisos correctos
        chmod 644 /usr/share/applications/ares-aegis.desktop
        chmod 644 /usr/share/pixmaps/ares-aegis*.png 2>/dev/null || true
        
        # Configurar permisos de directorios
        chown -R root:root /opt/ares-aegis
        chmod -R 755 /opt/ares-aegis
        
        # Permisos especiales para archivos de configuración
        if [ -d "/opt/ares-aegis/configuracion" ]; then
            chmod -R 644 /opt/ares-aegis/configuracion/*
        fi
        
        # Actualizar base de datos de aplicaciones
        update-desktop-database 2>/dev/null || true
        
        echo "✅ Ares Aegis instalado exitosamente"
        echo "🚀 Puedes ejecutarlo desde:"
        echo "   • Menú de aplicaciones (Categoría: Security)"
        echo "   • Terminal: ares-aegis"
        echo "   • Terminal con sudo: sudo ares-aegis"
        echo ""
        echo "🔐 Nota: Se solicitarán permisos de root para funcionalidad completa"
        ;;
        
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
        
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
