{
  "metadatos": {
    "version": "1.0.0",
    "autor": "DogSoulDev - Ares Aegis",
    "descripcion": "Herramientas y técnicas de criptografía para estudiantes de ciberseguridad",
    "fecha_actualizacion": "2025-07-20"
  },
  "categorias": {
    "hashing": {
      "titulo": "🔐 Funciones Hash y Checksums",
      "descripcion": "Herramientas para generar y verificar hashes",
      "herramientas": {
        "md5sum": {
          "descripcion": "Generar hash MD5 (no recomendado para seguridad)",
          "comandos": [
            {
              "comando": "md5sum ARCHIVO",
              "descripcion": "Calcular hash MD5 de un archivo",
              "ejemplo": "md5sum documento.pdf"
            },
            {
              "comando": "echo 'texto' | md5sum",
              "descripcion": "Hash MD5 de texto",
              "ejemplo": "echo 'password123' | md5sum"
            },
            {
              "comando": "md5sum -c ARCHIVO.md5",
              "descripcion": "Verificar integridad usando archivo de checksums",
              "ejemplo": "md5sum -c checksums.md5"
            }
          ]
        },
        "sha1sum": {
          "descripcion": "Generar hash SHA-1 (débil para seguridad)",
          "comandos": [
            {
              "comando": "sha1sum ARCHIVO",
              "descripcion": "Calcular hash SHA-1 de un archivo",
              "ejemplo": "sha1sum image.jpg"
            },
            {
              "comando": "echo 'texto' | sha1sum",
              "descripcion": "Hash SHA-1 de texto",
              "ejemplo": "echo 'secretpassword' | sha1sum"
            }
          ]
        },
        "sha256sum": {
          "descripcion": "Generar hash SHA-256 (recomendado)",
          "comandos": [
            {
              "comando": "sha256sum ARCHIVO",
              "descripcion": "Calcular hash SHA-256 de un archivo",
              "ejemplo": "sha256sum software.tar.gz"
            },
            {
              "comando": "echo 'texto' | sha256sum",
              "descripcion": "Hash SHA-256 de texto",
              "ejemplo": "echo 'mypassword' | sha256sum"
            },
            {
              "comando": "sha256sum -c ARCHIVO.sha256",
              "descripcion": "Verificar integridad con SHA-256",
              "ejemplo": "sha256sum -c hashes.sha256"
            }
          ]
        },
        "sha512sum": {
          "descripcion": "Generar hash SHA-512 (muy seguro)",
          "comandos": [
            {
              "comando": "sha512sum ARCHIVO",
              "descripcion": "Calcular hash SHA-512 de un archivo",
              "ejemplo": "sha512sum backup.zip"
            },
            {
              "comando": "echo 'texto' | sha512sum",
              "descripcion": "Hash SHA-512 de texto",
              "ejemplo": "echo 'supersecret' | sha512sum"
            }
          ]
        }
      }
    },
    "cifrado_simetrico": {
      "titulo": "🔄 Cifrado Simétrico",
      "descripcion": "Herramientas de cifrado con clave compartida",
      "herramientas": {
        "openssl_enc": {
          "descripcion": "Cifrado/descifrado con OpenSSL",
          "comandos": [
            {
              "comando": "openssl enc -aes-256-cbc -in ARCHIVO -out ARCHIVO.enc",
              "descripcion": "Cifrar archivo con AES-256-CBC",
              "ejemplo": "openssl enc -aes-256-cbc -in secreto.txt -out secreto.txt.enc"
            },
            {
              "comando": "openssl enc -aes-256-cbc -d -in ARCHIVO.enc -out ARCHIVO",
              "descripcion": "Descifrar archivo AES-256-CBC",
              "ejemplo": "openssl enc -aes-256-cbc -d -in secreto.txt.enc -out secreto.txt"
            },
            {
              "comando": "openssl enc -aes-256-gcm -in ARCHIVO -out ARCHIVO.enc -k PASSWORD",
              "descripcion": "Cifrar con contraseña específica",
              "ejemplo": "openssl enc -aes-256-gcm -in data.txt -out data.txt.enc -k mypassword"
            },
            {
              "comando": "echo 'texto' | openssl enc -base64",
              "descripcion": "Codificar en Base64",
              "ejemplo": "echo 'Hello World' | openssl enc -base64"
            },
            {
              "comando": "echo 'dGV4dG8=' | openssl enc -base64 -d",
              "descripcion": "Decodificar desde Base64",
              "ejemplo": "echo 'SGVsbG8gV29ybGQ=' | openssl enc -base64 -d"
            }
          ]
        },
        "gpg": {
          "descripcion": "GNU Privacy Guard para cifrado",
          "comandos": [
            {
              "comando": "gpg --gen-key",
              "descripcion": "Generar par de claves GPG",
              "ejemplo": "gpg --gen-key → seguir instrucciones interactivas"
            },
            {
              "comando": "gpg --list-keys",
              "descripcion": "Listar claves públicas",
              "ejemplo": "gpg --list-keys → mostrar todas las claves públicas"
            },
            {
              "comando": "gpg --list-secret-keys",
              "descripcion": "Listar claves privadas",
              "ejemplo": "gpg --list-secret-keys → mostrar claves privadas"
            },
            {
              "comando": "gpg -c ARCHIVO",
              "descripcion": "Cifrar archivo con contraseña simétrica",
              "ejemplo": "gpg -c documento.txt → crea documento.txt.gpg"
            },
            {
              "comando": "gpg -d ARCHIVO.gpg",
              "descripcion": "Descifrar archivo",
              "ejemplo": "gpg -d documento.txt.gpg > documento.txt"
            }
          ]
        }
      }
    },
    "cifrado_asimetrico": {
      "titulo": "🔑 Cifrado Asimétrico (Clave Pública)",
      "descripcion": "Herramientas de cifrado con pares de claves",
      "herramientas": {
        "ssh_keygen": {
          "descripcion": "Generar pares de claves SSH",
          "comandos": [
            {
              "comando": "ssh-keygen -t rsa -b 4096",
              "descripcion": "Generar clave RSA de 4096 bits",
              "ejemplo": "ssh-keygen -t rsa -b 4096 -C 'usuario@email.com'"
            },
            {
              "comando": "ssh-keygen -t ed25519",
              "descripcion": "Generar clave Ed25519 (recomendado)",
              "ejemplo": "ssh-keygen -t ed25519 -C 'usuario@email.com'"
            },
            {
              "comando": "ssh-keygen -t ecdsa -b 521",
              "descripcion": "Generar clave ECDSA",
              "ejemplo": "ssh-keygen -t ecdsa -b 521"
            },
            {
              "comando": "ssh-keygen -f ~/.ssh/id_rsa -p",
              "descripcion": "Cambiar passphrase de clave existente",
              "ejemplo": "ssh-keygen -f ~/.ssh/id_rsa -p"
            }
          ]
        },
        "openssl_rsa": {
          "descripcion": "Operaciones con claves RSA",
          "comandos": [
            {
              "comando": "openssl genrsa -out private.pem 2048",
              "descripcion": "Generar clave privada RSA",
              "ejemplo": "openssl genrsa -out private.pem 2048"
            },
            {
              "comando": "openssl rsa -in private.pem -pubout -out public.pem",
              "descripcion": "Extraer clave pública de la privada",
              "ejemplo": "openssl rsa -in private.pem -pubout -out public.pem"
            },
            {
              "comando": "openssl rsautl -encrypt -pubin -inkey public.pem -in ARCHIVO -out ARCHIVO.enc",
              "descripcion": "Cifrar con clave pública",
              "ejemplo": "openssl rsautl -encrypt -pubin -inkey public.pem -in secreto.txt -out secreto.enc"
            },
            {
              "comando": "openssl rsautl -decrypt -inkey private.pem -in ARCHIVO.enc -out ARCHIVO",
              "descripcion": "Descifrar con clave privada",
              "ejemplo": "openssl rsautl -decrypt -inkey private.pem -in secreto.enc -out secreto.txt"
            }
          ]
        },
        "gpg_asimetrico": {
          "descripcion": "GPG con cifrado asimétrico",
          "comandos": [
            {
              "comando": "gpg --import clave_publica.asc",
              "descripcion": "Importar clave pública de alguien",
              "ejemplo": "gpg --import friend_public_key.asc"
            },
            {
              "comando": "gpg --export -a USUARIO > clave_publica.asc",
              "descripcion": "Exportar tu clave pública",
              "ejemplo": "gpg --export -a 'usuario@email.com' > mi_clave.asc"
            },
            {
              "comando": "gpg -e -r DESTINATARIO ARCHIVO",
              "descripcion": "Cifrar archivo para alguien específico",
              "ejemplo": "gpg -e -r 'friend@email.com' documento.txt"
            },
            {
              "comando": "gpg --sign ARCHIVO",
              "descripcion": "Firmar archivo digitalmente",
              "ejemplo": "gpg --sign contrato.pdf"
            },
            {
              "comando": "gpg --verify ARCHIVO.sig",
              "descripcion": "Verificar firma digital",
              "ejemplo": "gpg --verify contrato.pdf.sig"
            }
          ]
        }
      }
    },
    "cracking_hashes": {
      "titulo": "🔓 Cracking de Hashes",
      "descripcion": "Herramientas para romper hashes y contraseñas",
      "herramientas": {
        "john": {
          "descripcion": "John the Ripper - crackeador de contraseñas",
          "comandos": [
            {
              "comando": "john ARCHIVO_HASHES",
              "descripcion": "Crackear hashes con wordlist por defecto",
              "ejemplo": "john hashes.txt"
            },
            {
              "comando": "john --wordlist=WORDLIST ARCHIVO_HASHES",
              "descripcion": "Usar wordlist específica",
              "ejemplo": "john --wordlist=/usr/share/wordlists/rockyou.txt hashes.txt"
            },
            {
              "comando": "john --format=FORMAT ARCHIVO_HASHES",
              "descripcion": "Especificar formato de hash",
              "ejemplo": "john --format=md5 md5_hashes.txt"
            },
            {
              "comando": "john --show ARCHIVO_HASHES",
              "descripcion": "Mostrar contraseñas crackeadas",
              "ejemplo": "john --show hashes.txt"
            },
            {
              "comando": "john --incremental ARCHIVO_HASHES",
              "descripcion": "Modo incremental (fuerza bruta)",
              "ejemplo": "john --incremental hashes.txt"
            }
          ]
        },
        "hashcat": {
          "descripcion": "Hashcat - crackeador de hashes con GPU",
          "comandos": [
            {
              "comando": "hashcat -m MODO HASHES WORDLIST",
              "descripcion": "Crackear con modo específico",
              "ejemplo": "hashcat -m 0 md5hashes.txt rockyou.txt"
            },
            {
              "comando": "hashcat -m 0 -a 3 HASH ?l?l?l?l",
              "descripcion": "Ataque de fuerza bruta con máscara",
              "ejemplo": "hashcat -m 0 -a 3 hash.txt ?l?l?l?l → 4 letras minúsculas"
            },
            {
              "comando": "hashcat -m 1000 HASHES WORDLIST",
              "descripcion": "Crackear hashes NTLM",
              "ejemplo": "hashcat -m 1000 ntlm_hashes.txt passwords.txt"
            },
            {
              "comando": "hashcat -m 1800 HASHES WORDLIST",
              "descripcion": "Crackear hashes SHA-512",
              "ejemplo": "hashcat -m 1800 sha512_hashes.txt wordlist.txt"
            },
            {
              "comando": "hashcat --show HASHES",
              "descripcion": "Mostrar hashes crackeados",
              "ejemplo": "hashcat --show cracked_hashes.txt"
            }
          ]
        },
        "hydra": {
          "descripcion": "Hydra - ataque de fuerza bruta a servicios",
          "comandos": [
            {
              "comando": "hydra -l USER -p PASS HOST SERVICIO",
              "descripcion": "Ataque con usuario y contraseña específicos",
              "ejemplo": "hydra -l admin -p admin 192.168.1.100 ssh"
            },
            {
              "comando": "hydra -L USUARIOS -P PASSWORDS HOST SERVICIO",
              "descripcion": "Ataque con listas de usuarios y contraseñas",
              "ejemplo": "hydra -L users.txt -P passwords.txt 192.168.1.100 ftp"
            },
            {
              "comando": "hydra -l USER -P PASSWORDS HOST http-post-form",
              "descripcion": "Ataque a formulario web",
              "ejemplo": "hydra -l admin -P passwords.txt target.com http-post-form '/login:user=^USER^&pass=^PASS^:Invalid'"
            },
            {
              "comando": "hydra -L USUARIOS -P PASSWORDS HOST rdp",
              "descripcion": "Ataque a escritorio remoto",
              "ejemplo": "hydra -L users.txt -P passwords.txt 192.168.1.100 rdp"
            }
          ]
        }
      }
    },
    "esteganografia": {
      "titulo": "🖼️ Esteganografía",
      "descripcion": "Técnicas para ocultar y extraer información en archivos",
      "herramientas": {
        "steghide": {
          "descripcion": "Ocultar archivos en imágenes y audio",
          "comandos": [
            {
              "comando": "steghide embed -cf IMAGEN -ef ARCHIVO",
              "descripcion": "Ocultar archivo en imagen",
              "ejemplo": "steghide embed -cf photo.jpg -ef secret.txt"
            },
            {
              "comando": "steghide extract -sf IMAGEN",
              "descripcion": "Extraer archivo oculto de imagen",
              "ejemplo": "steghide extract -sf photo.jpg"
            },
            {
              "comando": "steghide info IMAGEN",
              "descripcion": "Obtener información sobre archivo esteganográfico",
              "ejemplo": "steghide info suspicious_image.jpg"
            }
          ]
        },
        "strings": {
          "descripcion": "Extraer cadenas de texto de archivos",
          "comandos": [
            {
              "comando": "strings ARCHIVO",
              "descripcion": "Mostrar todas las cadenas legibles",
              "ejemplo": "strings image.jpg | grep -i password"
            },
            {
              "comando": "strings -n 8 ARCHIVO",
              "descripcion": "Mostrar cadenas de mínimo 8 caracteres",
              "ejemplo": "strings -n 8 binary_file"
            },
            {
              "comando": "strings ARCHIVO | grep PATRON",
              "descripcion": "Buscar patrón específico en cadenas",
              "ejemplo": "strings file.jpg | grep 'flag\\|password\\|key'"
            }
          ]
        },
        "binwalk": {
          "descripcion": "Analizar archivos en busca de contenido embebido",
          "comandos": [
            {
              "comando": "binwalk ARCHIVO",
              "descripcion": "Analizar archivo en busca de firmas conocidas",
              "ejemplo": "binwalk firmware.bin"
            },
            {
              "comando": "binwalk -e ARCHIVO",
              "descripcion": "Extraer archivos encontrados",
              "ejemplo": "binwalk -e firmware.bin"
            },
            {
              "comando": "binwalk --dd='.*' ARCHIVO",
              "descripcion": "Extraer todo el contenido encontrado",
              "ejemplo": "binwalk --dd='.*' suspicious_file.bin"
            }
          ]
        },
        "exiftool": {
          "descripcion": "Leer y escribir metadatos de archivos",
          "comandos": [
            {
              "comando": "exiftool ARCHIVO",
              "descripcion": "Mostrar todos los metadatos",
              "ejemplo": "exiftool photo.jpg"
            },
            {
              "comando": "exiftool -Comment='Texto oculto' ARCHIVO",
              "descripcion": "Agregar comentario a archivo",
              "ejemplo": "exiftool -Comment='Secret message' image.jpg"
            },
            {
              "comando": "exiftool -Comment ARCHIVO",
              "descripcion": "Mostrar solo comentarios",
              "ejemplo": "exiftool -Comment *.jpg"
            }
          ]
        }
      }
    },
    "certificados": {
      "titulo": "📜 Certificados y PKI",
      "descripcion": "Gestión de certificados digitales",
      "herramientas": {
        "openssl_certs": {
          "descripcion": "Operaciones con certificados",
          "comandos": [
            {
              "comando": "openssl req -new -x509 -days 365 -nodes -out cert.pem -keyout key.pem",
              "descripcion": "Crear certificado autofirmado",
              "ejemplo": "openssl req -new -x509 -days 365 -nodes -out server.pem -keyout server.key"
            },
            {
              "comando": "openssl x509 -in CERT -text -noout",
              "descripcion": "Ver información del certificado",
              "ejemplo": "openssl x509 -in certificate.pem -text -noout"
            },
            {
              "comando": "openssl s_client -connect HOST:PORT",
              "descripcion": "Conectar y ver certificado de servidor",
              "ejemplo": "openssl s_client -connect google.com:443"
            },
            {
              "comando": "openssl x509 -in CERT -dates -noout",
              "descripcion": "Ver fechas de validez del certificado",
              "ejemplo": "openssl x509 -in server.pem -dates -noout"
            }
          ]
        }
      }
    }
  }
}
