{
  "metadatos": {
    "version": "1.0.0",
    "autor": "DogSoulDev - Ares Aegis",
    "descripcion": "Comandos básicos de Linux para estudiantes de ciberseguridad",
    "fecha_actualizacion": "2025-07-20"
  },
  "categorias": {
    "navegacion": {
      "titulo": "🧭 Navegación del Sistema de Archivos",
      "descripcion": "Comandos fundamentales para moverse por el sistema",
      "herramientas": {
        "pwd": {
          "descripcion": "Mostrar directorio actual",
          "comandos": [
            {
              "comando": "pwd",
              "descripcion": "Imprimir directorio de trabajo actual",
              "ejemplo": "pwd → /home/user/documents"
            }
          ]
        },
        "cd": {
          "descripcion": "Cambiar de directorio",
          "comandos": [
            {
              "comando": "cd DIRECTORIO",
              "descripcion": "Cambiar al directorio especificado",
              "ejemplo": "cd /etc"
            },
            {
              "comando": "cd ~",
              "descripcion": "Ir al directorio home del usuario",
              "ejemplo": "cd ~ → /home/username"
            },
            {
              "comando": "cd ..",
              "descripcion": "Subir un nivel en el directorio",
              "ejemplo": "cd .. → directorio padre"
            },
            {
              "comando": "cd -",
              "descripcion": "Volver al directorio anterior",
              "ejemplo": "cd - → último directorio visitado"
            }
          ]
        },
        "ls": {
          "descripcion": "Listar contenido de directorios",
          "comandos": [
            {
              "comando": "ls",
              "descripcion": "Listar archivos y directorios",
              "ejemplo": "ls → archivo1.txt directorio1"
            },
            {
              "comando": "ls -la",
              "descripcion": "Listar todo incluyendo archivos ocultos con permisos",
              "ejemplo": "ls -la → drwxr-xr-x 2 user user 4096 jul 20 10:30 ."
            },
            {
              "comando": "ls -lh",
              "descripcion": "Listar con tamaños legibles",
              "ejemplo": "ls -lh → -rw-r--r-- 1 user user 1.5K jul 20 archivo.txt"
            },
            {
              "comando": "ls -R",
              "descripcion": "Listar recursivamente todos los subdirectorios",
              "ejemplo": "ls -R → muestra todo el árbol de directorios"
            }
          ]
        }
      }
    },
    "archivos": {
      "titulo": "📁 Gestión de Archivos y Directorios",
      "descripcion": "Comandos para crear, copiar, mover y eliminar archivos",
      "herramientas": {
        "mkdir": {
          "descripcion": "Crear directorios",
          "comandos": [
            {
              "comando": "mkdir DIRECTORIO",
              "descripcion": "Crear un directorio",
              "ejemplo": "mkdir proyecto"
            },
            {
              "comando": "mkdir -p RUTA/ANIDADA",
              "descripcion": "Crear directorios padre si no existen",
              "ejemplo": "mkdir -p documentos/proyectos/web"
            },
            {
              "comando": "mkdir -m 755 DIRECTORIO",
              "descripcion": "Crear directorio con permisos específicos",
              "ejemplo": "mkdir -m 755 public_html"
            }
          ]
        },
        "touch": {
          "descripcion": "Crear archivos vacíos o actualizar timestamps",
          "comandos": [
            {
              "comando": "touch ARCHIVO",
              "descripcion": "Crear archivo vacío o actualizar fecha",
              "ejemplo": "touch nuevo_archivo.txt"
            },
            {
              "comando": "touch archivo1 archivo2 archivo3",
              "descripcion": "Crear múltiples archivos",
              "ejemplo": "touch script.sh config.conf readme.md"
            }
          ]
        },
        "cp": {
          "descripcion": "Copiar archivos y directorios",
          "comandos": [
            {
              "comando": "cp ORIGEN DESTINO",
              "descripcion": "Copiar archivo",
              "ejemplo": "cp archivo.txt backup_archivo.txt"
            },
            {
              "comando": "cp -r DIRECTORIO DESTINO",
              "descripcion": "Copiar directorio recursivamente",
              "ejemplo": "cp -r proyecto/ backup_proyecto/"
            },
            {
              "comando": "cp -p ARCHIVO DESTINO",
              "descripcion": "Conservar permisos y timestamps",
              "ejemplo": "cp -p config.conf config.conf.bak"
            }
          ]
        },
        "mv": {
          "descripcion": "Mover o renombrar archivos",
          "comandos": [
            {
              "comando": "mv ORIGEN DESTINO",
              "descripcion": "Mover o renombrar archivo",
              "ejemplo": "mv archivo_viejo.txt archivo_nuevo.txt"
            },
            {
              "comando": "mv ARCHIVO DIRECTORIO/",
              "descripcion": "Mover archivo a directorio",
              "ejemplo": "mv documento.pdf documentos/"
            }
          ]
        },
        "rm": {
          "descripcion": "Eliminar archivos y directorios",
          "comandos": [
            {
              "comando": "rm ARCHIVO",
              "descripcion": "Eliminar archivo",
              "ejemplo": "rm archivo_temporal.tmp"
            },
            {
              "comando": "rm -r DIRECTORIO",
              "descripcion": "Eliminar directorio recursivamente",
              "ejemplo": "rm -r directorio_temporal/"
            },
            {
              "comando": "rm -f ARCHIVO",
              "descripcion": "Forzar eliminación sin confirmación",
              "ejemplo": "rm -f archivo_problemático.txt"
            },
            {
              "comando": "rm -rf DIRECTORIO",
              "descripcion": "¡PELIGROSO! Eliminar forzadamente todo",
              "ejemplo": "rm -rf /* → ¡NUNCA HAGAS ESTO!"
            }
          ]
        }
      }
    },
    "permisos": {
      "titulo": "🔐 Permisos y Propiedades",
      "descripcion": "Gestión de permisos, propietarios y atributos de archivos",
      "herramientas": {
        "chmod": {
          "descripcion": "Cambiar permisos de archivos",
          "comandos": [
            {
              "comando": "chmod 755 ARCHIVO",
              "descripcion": "Permisos: rwx para propietario, rx para grupo y otros",
              "ejemplo": "chmod 755 script.sh"
            },
            {
              "comando": "chmod +x ARCHIVO",
              "descripcion": "Agregar permiso de ejecución",
              "ejemplo": "chmod +x mi_script.py"
            },
            {
              "comando": "chmod u+rwx,g+rx,o+r ARCHIVO",
              "descripcion": "Permisos específicos por usuario/grupo/otros",
              "ejemplo": "chmod u+rwx,g+rx,o+r documento.txt"
            },
            {
              "comando": "chmod -R 644 DIRECTORIO/",
              "descripcion": "Aplicar permisos recursivamente",
              "ejemplo": "chmod -R 644 public_html/"
            }
          ]
        },
        "chown": {
          "descripcion": "Cambiar propietario de archivos",
          "comandos": [
            {
              "comando": "chown USUARIO ARCHIVO",
              "descripcion": "Cambiar propietario",
              "ejemplo": "chown john documento.txt"
            },
            {
              "comando": "chown USUARIO:GRUPO ARCHIVO",
              "descripcion": "Cambiar propietario y grupo",
              "ejemplo": "chown john:developers script.sh"
            },
            {
              "comando": "chown -R USUARIO DIRECTORIO/",
              "descripcion": "Cambiar propietario recursivamente",
              "ejemplo": "chown -R www-data /var/www/"
            }
          ]
        },
        "chgrp": {
          "descripcion": "Cambiar grupo de archivos",
          "comandos": [
            {
              "comando": "chgrp GRUPO ARCHIVO",
              "descripcion": "Cambiar grupo del archivo",
              "ejemplo": "chgrp developers proyecto.tar.gz"
            },
            {
              "comando": "chgrp -R GRUPO DIRECTORIO/",
              "descripcion": "Cambiar grupo recursivamente",
              "ejemplo": "chgrp -R wheel /opt/tools/"
            }
          ]
        }
      }
    },
    "texto": {
      "titulo": "📝 Manipulación de Texto",
      "descripcion": "Herramientas para ver, editar y procesar archivos de texto",
      "herramientas": {
        "cat": {
          "descripcion": "Mostrar contenido de archivos",
          "comandos": [
            {
              "comando": "cat ARCHIVO",
              "descripcion": "Mostrar todo el contenido del archivo",
              "ejemplo": "cat /etc/passwd"
            },
            {
              "comando": "cat archivo1 archivo2",
              "descripcion": "Concatenar y mostrar múltiples archivos",
              "ejemplo": "cat log1.txt log2.txt"
            },
            {
              "comando": "cat -n ARCHIVO",
              "descripcion": "Mostrar con números de línea",
              "ejemplo": "cat -n script.py"
            }
          ]
        },
        "less": {
          "descripcion": "Ver archivos página por página",
          "comandos": [
            {
              "comando": "less ARCHIVO",
              "descripcion": "Ver archivo con navegación (q para salir)",
              "ejemplo": "less /var/log/syslog"
            },
            {
              "comando": "less +G ARCHIVO",
              "descripcion": "Ir al final del archivo",
              "ejemplo": "less +G error.log"
            }
          ]
        },
        "head": {
          "descripcion": "Mostrar las primeras líneas",
          "comandos": [
            {
              "comando": "head ARCHIVO",
              "descripcion": "Mostrar primeras 10 líneas",
              "ejemplo": "head access.log"
            },
            {
              "comando": "head -n 20 ARCHIVO",
              "descripcion": "Mostrar primeras N líneas",
              "ejemplo": "head -n 20 config.conf"
            }
          ]
        },
        "tail": {
          "descripcion": "Mostrar las últimas líneas",
          "comandos": [
            {
              "comando": "tail ARCHIVO",
              "descripcion": "Mostrar últimas 10 líneas",
              "ejemplo": "tail error.log"
            },
            {
              "comando": "tail -n 50 ARCHIVO",
              "descripcion": "Mostrar últimas N líneas",
              "ejemplo": "tail -n 50 /var/log/auth.log"
            },
            {
              "comando": "tail -f ARCHIVO",
              "descripcion": "Seguir archivo en tiempo real",
              "ejemplo": "tail -f /var/log/apache2/access.log"
            }
          ]
        },
        "grep": {
          "descripcion": "Buscar texto en archivos",
          "comandos": [
            {
              "comando": "grep PATRON ARCHIVO",
              "descripcion": "Buscar patrón en archivo",
              "ejemplo": "grep 'error' /var/log/syslog"
            },
            {
              "comando": "grep -i PATRON ARCHIVO",
              "descripcion": "Búsqueda sin distinguir mayúsculas",
              "ejemplo": "grep -i 'WARNING' log.txt"
            },
            {
              "comando": "grep -r PATRON DIRECTORIO/",
              "descripcion": "Búsqueda recursiva en directorios",
              "ejemplo": "grep -r 'password' /etc/"
            },
            {
              "comando": "grep -v PATRON ARCHIVO",
              "descripcion": "Mostrar líneas que NO coinciden",
              "ejemplo": "grep -v '#' config.conf"
            },
            {
              "comando": "grep -n PATRON ARCHIVO",
              "descripcion": "Mostrar números de línea",
              "ejemplo": "grep -n 'function' script.js"
            }
          ]
        }
      }
    },
    "procesos": {
      "titulo": "⚙️ Gestión de Procesos",
      "descripcion": "Comandos para monitorear y controlar procesos del sistema",
      "herramientas": {
        "ps": {
          "descripcion": "Mostrar procesos en ejecución",
          "comandos": [
            {
              "comando": "ps aux",
              "descripcion": "Mostrar todos los procesos con detalles",
              "ejemplo": "ps aux | grep apache"
            },
            {
              "comando": "ps -ef",
              "descripcion": "Mostrar todos los procesos en formato completo",
              "ejemplo": "ps -ef | head -20"
            },
            {
              "comando": "ps -u USUARIO",
              "descripcion": "Mostrar procesos de un usuario específico",
              "ejemplo": "ps -u www-data"
            }
          ]
        },
        "top": {
          "descripcion": "Monitor de procesos en tiempo real",
          "comandos": [
            {
              "comando": "top",
              "descripcion": "Mostrar procesos ordenados por uso de CPU",
              "ejemplo": "top → presiona 'q' para salir"
            },
            {
              "comando": "top -u USUARIO",
              "descripcion": "Mostrar solo procesos de un usuario",
              "ejemplo": "top -u apache"
            }
          ]
        },
        "htop": {
          "descripcion": "Versión mejorada de top (si está instalado)",
          "comandos": [
            {
              "comando": "htop",
              "descripcion": "Monitor interactivo de procesos",
              "ejemplo": "htop → F10 para salir"
            }
          ]
        },
        "kill": {
          "descripcion": "Terminar procesos",
          "comandos": [
            {
              "comando": "kill PID",
              "descripcion": "Terminar proceso por ID",
              "ejemplo": "kill 1234"
            },
            {
              "comando": "kill -9 PID",
              "descripcion": "Forzar terminación de proceso",
              "ejemplo": "kill -9 5678"
            },
            {
              "comando": "killall PROCESO",
              "descripcion": "Terminar todos los procesos por nombre",
              "ejemplo": "killall firefox"
            }
          ]
        },
        "jobs": {
          "descripcion": "Gestionar trabajos en segundo plano",
          "comandos": [
            {
              "comando": "jobs",
              "descripcion": "Listar trabajos activos",
              "ejemplo": "jobs → [1]+ Running    script.sh &"
            },
            {
              "comando": "bg %1",
              "descripcion": "Poner trabajo en segundo plano",
              "ejemplo": "bg %1 → continúa trabajo 1 en background"
            },
            {
              "comando": "fg %1",
              "descripcion": "Traer trabajo a primer plano",
              "ejemplo": "fg %1 → trae trabajo 1 al foreground"
            }
          ]
        }
      }
    },
    "redes": {
      "titulo": "🌐 Comandos de Red Básicos",
      "descripcion": "Herramientas básicas para diagnóstico de red",
      "herramientas": {
        "ping": {
          "descripcion": "Probar conectividad de red",
          "comandos": [
            {
              "comando": "ping HOST",
              "descripcion": "Enviar paquetes ICMP a un host",
              "ejemplo": "ping google.com"
            },
            {
              "comando": "ping -c 4 HOST",
              "descripcion": "Enviar solo 4 paquetes",
              "ejemplo": "ping -c 4 8.8.8.8"
            }
          ]
        },
        "wget": {
          "descripcion": "Descargar archivos desde internet",
          "comandos": [
            {
              "comando": "wget URL",
              "descripcion": "Descargar archivo desde URL",
              "ejemplo": "wget https://example.com/file.zip"
            },
            {
              "comando": "wget -r URL",
              "descripcion": "Descarga recursiva de sitio web",
              "ejemplo": "wget -r https://example.com"
            }
          ]
        },
        "curl": {
          "descripcion": "Transferir datos desde/hacia servidores",
          "comandos": [
            {
              "comando": "curl URL",
              "descripcion": "Obtener contenido de URL",
              "ejemplo": "curl https://api.github.com"
            },
            {
              "comando": "curl -O URL",
              "descripcion": "Descargar archivo manteniendo nombre",
              "ejemplo": "curl -O https://example.com/file.pdf"
            },
            {
              "comando": "curl -X POST -d 'data' URL",
              "descripcion": "Enviar datos POST",
              "ejemplo": "curl -X POST -d 'user=john' https://api.example.com"
            }
          ]
        }
      }
    }
  }
}
