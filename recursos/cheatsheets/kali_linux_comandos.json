    "wireless": {
      "titulo": "📡 Wireless Hacking",
      "descripcion": "Herramientas para auditoría de redes inalámbricas",
      "herramientas": {
        "aircrack-ng": {
          "descripcion": "Suite completa para auditoría WiFi",
          "comandos": [
            {
              "comando": "airmon-ng start INTERFACE",
              "descripcion": "Poner interfaz en modo monitor",
              "ejemplo": "airmon-ng start wlan0"
            },
            {
              "comando": "airodump-ng INTERFACE_MON",
              "descripcion": "Escanear redes WiFi disponibles",
              "ejemplo": "airodump-ng wlan0mon"
            },
            {
              "comando": "airodump-ng -c CHANNEL --bssid BSSID -w OUTPUT INTERFACE",
              "descripcion": "Capturar handshake WPA/WPA2",
              "ejemplo": "airodump-ng -c 6 --bssid 00:11:22:33:44:55 -w capture wlan0mon"
            },
            {
              "comando": "aireplay-ng -0 COUNT -a BSSID INTERFACE",
              "descripcion": "Ataque de desautenticación",
              "ejemplo": "aireplay-ng -0 10 -a 00:11:22:33:44:55 wlan0mon"
            },
            {
              "comando": "aircrack-ng -w WORDLIST CAPTURE_FILE",
              "descripcion": "Crackear WPA/WPA2 con diccionario",
              "ejemplo": "aircrack-ng -w /usr/share/wordlists/rockyou.txt handshake.cap"
            }
          ]
        },
        "reaver": {
          "descripcion": "Ataque WPS con fuerza bruta",
          "comandos": [
            {
              "comando": "reaver -i INTERFACE -b BSSID -vv",
              "descripcion": "Ataque WPS básico con verbose",
              "ejemplo": "reaver -i wlan0mon -b AA:BB:CC:DD:EE:FF -vv"
            },
            {
              "comando": "reaver -i INTERFACE -b BSSID -vv -d DELAY",
              "descripcion": "Ataque WPS con delay personalizado",
              "ejemplo": "reaver -i wlan0mon -b 00:22:44:66:88:AA -vv -d 15"
            },
            {
              "comando": "wash -i INTERFACE",
              "descripcion": "Buscar APs con WPS habilitado",
              "ejemplo": "wash -i wlan0mon"
            }
          ]
        },
        "kismet": {
          "descripcion": "Detector y analizador de redes inalámbricas",
          "comandos": [
            {
              "comando": "kismet",
              "descripcion": "Iniciar Kismet con interfaz web",
              "ejemplo": "kismet"
            },
            {
              "comando": "kismet -c INTERFACE",
              "descripcion": "Especificar interfaz de captura",
              "ejemplo": "kismet -c wlan0"
            }
