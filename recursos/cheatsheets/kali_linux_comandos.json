  "categorias": {
    "reconocimiento": {
      "titulo": "🔍 Reconocimiento y Escaneo",
      "descripcion": "Herramientas para recopilar información sobre objetivos",
      "herramientas": {
        "nmap": {
          "descripcion": "Escáner de red y puertos más potente",
          "comandos": [
            {
              "comando": "nmap -sS TARGET",
              "descripcion": "Escaneo SYN stealth de un host",
              "ejemplo": "nmap -sS hackthebox.eu"
            },
            {
              "comando": "nmap -sV -O NETWORK/CIDR",
              "descripcion": "Detección de versión y OS en red",
              "ejemplo": "nmap -sV -O 172.16.0.0/16"
            },
            {
              "comando": "nmap -p- --open HOST",
              "descripcion": "Escanear todos los puertos abiertos",
              "ejemplo": "nmap -p- --open tryhackme.com"
            },
            {
              "comando": "nmap -sC -sV -oA OUTPUT HOST",
              "descripcion": "Escaneo completo con scripts y detección",
              "ejemplo": "nmap -sC -sV -oA full_scan vulnhub.local"
            },
            {
              "comando": "nmap --script vuln HOST",
              "descripcion": "Ejecutar scripts de vulnerabilidades",
              "ejemplo": "nmap --script vuln 10.129.95.234"
            }
          ]
        },
        "netdiscover": {
          "descripcion": "Descubrimiento de hosts en red local",
          "comandos": [
            {
              "comando": "netdiscover -r NETWORK/CIDR",
              "descripcion": "Descubrir hosts en rango de red",
              "ejemplo": "netdiscover -r 172.31.0.0/16"
            },
            {
              "comando": "netdiscover -i INTERFACE -r NETWORK",
              "descripcion": "Especificar interfaz para descubrimiento",
              "ejemplo": "netdiscover -i eth1 -r 10.0.0.0/8"
            }
          ]
        },
        "masscan": {
          "descripcion": "Escáner de puertos ultra-rápido",
          "comandos": [
            {
              "comando": "masscan -p PORTS NETWORK --rate=RATE",
              "descripcion": "Escaneo rápido de puertos específicos",
              "ejemplo": "masscan -p21,22,23,53,80,443,993,995 192.168.0.0/16 --rate=2000"
            },
            {
              "comando": "masscan -pU:53,161 NETWORK --rate=RATE",
              "descripcion": "Escaneo UDP de puertos específicos",
              "ejemplo": "masscan -pU:53,161,162,500 10.10.0.0/16 --rate=1500"
            }
          ]
        },
        "gobuster": {
          "descripcion": "Enumeración de directorios y archivos web",
          "comandos": [
            {
              "comando": "gobuster dir -u URL -w WORDLIST",
              "descripcion": "Buscar directorios ocultos",
              "ejemplo": "gobuster dir -u https://example.com -w /usr/share/seclists/Discovery/Web-Content/common.txt"
            },
            {
              "comando": "gobuster dns -d DOMAIN -w WORDLIST",
              "descripcion": "Enumeración de subdominios",
              "ejemplo": "gobuster dns -d microsoft.com -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-110000.txt"
            }
          ]
        }
      }
    },
    "vulnerabilidades": {
      "titulo": "🛡️ Análisis de Vulnerabilidades",
      "descripcion": "Herramientas para identificar y explotar vulnerabilidades",
      "herramientas": {
        "nikto": {
          "descripcion": "Escáner de vulnerabilidades web",
          "comandos": [
            {
              "comando": "nikto -h URL",
              "descripcion": "Escaneo básico de vulnerabilidades web",
              "ejemplo": "nikto -h https://owasp.org"
            },
            {
              "comando": "nikto -h URL -p PORT -ssl",
              "descripcion": "Escaneo HTTPS en puerto específico",
              "ejemplo": "nikto -h https://target.htb -p 8443 -ssl"
            },
            {
              "comando": "nikto -h URL -o OUTPUT.txt -Format txt",
              "descripcion": "Guardar resultados en archivo",
              "ejemplo": "nikto -h http://vulnerable.local -o scan_results.txt -Format txt"
            }
          ]
        },
        "openvas": {
          "descripcion": "Suite completa de análisis de vulnerabilidades",
          "comandos": [
            {
              "comando": "gvm-start",
              "descripcion": "Iniciar servicios OpenVAS/GVM",
              "ejemplo": "gvm-start"
            },
            {
              "comando": "gvm-check-setup",
              "descripcion": "Verificar configuración del sistema",
              "ejemplo": "gvm-check-setup"
            }
          ]
        },
        "sqlmap": {
          "descripcion": "Herramienta para detectar y explotar SQL injection",
          "comandos": [
            {
              "comando": "sqlmap -u 'URL?param=VALUE' --dbs",
              "descripcion": "Detectar SQL injection y listar bases de datos",
              "ejemplo": "sqlmap -u 'http://testphp.vulnweb.com/listproducts.php?cat=1' --dbs"
            },
            {
              "comando": "sqlmap -u URL --forms --batch --crawl=3",
              "descripcion": "Escaneo automático de formularios",
              "ejemplo": "sqlmap -u http://dvwa.local --forms --batch --crawl=2"
            },
            {
              "comando": "sqlmap -r REQUEST.txt --dump",
              "descripcion": "Usar archivo de request y extraer datos",
              "ejemplo": "sqlmap -r burp_request.txt --dump -T users"
            }
          ]
        },
        "wpscan": {
          "descripcion": "Escáner de vulnerabilidades WordPress",
          "comandos": [
            {
              "comando": "wpscan --url URL --enumerate u,p,t",
              "descripcion": "Enumerar usuarios, plugins y temas",
              "ejemplo": "wpscan --url https://blog.example.com --enumerate u,p,t"
            },
            {
              "comando": "wpscan --url URL --passwords WORDLIST",
              "descripcion": "Ataque de fuerza bruta a usuarios",
              "ejemplo": "wpscan --url http://wordpress.local --passwords /usr/share/wordlists/rockyou.txt"
            }
          ]
        }
      }
    },
    "explotacion": {
      "titulo": "⚔️ Explotación",
      "descripcion": "Herramientas para explotar vulnerabilidades encontradas",
      "herramientas": {
        "metasploit": {
          "descripcion": "Framework de explotación más completo",
          "comandos": [
            {
              "comando": "msfconsole",
              "descripcion": "Iniciar consola de Metasploit",
              "ejemplo": "msfconsole -q"
            },
            {
              "comando": "search KEYWORD",
              "descripcion": "Buscar exploits específicos",
              "ejemplo": "search type:exploit platform:windows smb"
            },
            {
              "comando": "use EXPLOIT_PATH",
              "descripcion": "Seleccionar exploit específico",
              "ejemplo": "use auxiliary/scanner/portscan/syn"
            },
            {
              "comando": "set PARAMETER VALUE",
              "descripcion": "Configurar parámetros del exploit",
              "ejemplo": "set RHOSTS 10.10.10.0/24"
            },
            {
              "comando": "show payloads",
              "descripcion": "Mostrar payloads compatibles",
              "ejemplo": "show payloads"
            }
          ]
        },
        "hydra": {
          "descripcion": "Herramienta de fuerza bruta para passwords",
          "comandos": [
            {
              "comando": "hydra -l USER -P WORDLIST PROTOCOL://TARGET",
              "descripcion": "Ataque de fuerza bruta básico",
              "ejemplo": "hydra -l administrator -P /usr/share/wordlists/rockyou.txt ssh://10.129.95.134"
            },
            {
              "comando": "hydra -L USERLIST -p PASSWORD PROTOCOL://TARGET",
              "descripcion": "Probar una contraseña contra múltiples usuarios",
              "ejemplo": "hydra -L users.txt -p password123 ftp://192.168.1.100"
            },
            {
              "comando": "hydra -l USER -P WORDLIST TARGET http-post-form 'PATH:PARAMS:ERROR'",
              "descripcion": "Ataque a formulario web HTTP POST",
              "ejemplo": "hydra -l admin -P passwords.txt example.com http-post-form '/login:username=^USER^&password=^PASS^:Invalid credentials'"
            }
          ]
        },
        "john": {
          "descripcion": "Crackeador de contraseñas John the Ripper",
          "comandos": [
            {
              "comando": "john --wordlist=WORDLIST HASHFILE",
              "descripcion": "Crackear hashes con diccionario",
              "ejemplo": "john --wordlist=/usr/share/wordlists/rockyou.txt /etc/shadow"
            },
            {
              "comando": "john --show HASHFILE",
              "descripcion": "Mostrar contraseñas crackeadas",
              "ejemplo": "john --show hashes.txt"
            },
            {
              "comando": "john --format=FORMAT HASHFILE",
              "descripcion": "Especificar formato de hash",
              "ejemplo": "john --format=md5crypt-long hash_md5.txt"
            }
          ]
        },
        "hashcat": {
          "descripcion": "Crackeador de contraseñas avanzado con GPU",
          "comandos": [
            {
              "comando": "hashcat -m MODE HASHFILE WORDLIST",
              "descripcion": "Crackear hashes especificando modo",
              "ejemplo": "hashcat -m 1000 ntlm_hashes.txt /usr/share/wordlists/rockyou.txt"
            },
            {
              "comando": "hashcat -m MODE HASHFILE -a 3 MASK",
              "descripcion": "Ataque de fuerza bruta con máscara",
              "ejemplo": "hashcat -m 0 md5_hash.txt -a 3 ?d?d?d?d?d?d"
            }
          ]
        }
      }
    },
