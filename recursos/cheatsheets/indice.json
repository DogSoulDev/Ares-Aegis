    "sqlmap_injection": {
      "nombre": "SQLMap - Inyección SQL",
      "descripcion": "Herramienta automática para detectar y explotar inyecciones SQL",
      "categoria": "explotacion",
      "dificultad": "intermedio",
      "plataforma": "kali_linux",
      "comandos": [
        {
          "nombre": "Escaneo básico",
          "comando": "sqlmap -u \"[URL]\"",
          "descripcion": "Escanea URL en busca de inyecciones SQL",
          "ejemplo": "sqlmap -u \"http://ejemplo.com/page.php?id=1\"",
          "uso": "Detección inicial de vulnerabilidades SQL"
        },
        {
          "nombre": "Listar bases de datos",
          "comando": "sqlmap -u \"[URL]\" --dbs",
          "descripcion": "Enumera bases de datos disponibles",
          "ejemplo": "sqlmap -u \"http://ejemplo.com/page.php?id=1\" --dbs",
          "uso": "Reconocimiento de estructura de BD"
        },
        {
          "nombre": "Listar tablas",
          "comando": "sqlmap -u \"[URL]\" -D [BD] --tables",
          "descripcion": "Enumera tablas de una base de datos",
          "ejemplo": "sqlmap -u \"http://ejemplo.com/page.php?id=1\" -D users --tables",
          "uso": "Exploración de estructura de tablas"
        },
        {
          "nombre": "Volcar datos",
          "comando": "sqlmap -u \"[URL]\" -D [BD] -T [tabla] --dump",
          "descripcion": "Extrae datos de una tabla específica",
          "ejemplo": "sqlmap -u \"http://ejemplo.com/page.php?id=1\" -D users -T admin --dump",
          "uso": "Extracción de datos sensibles"
        }
      ]
    },
    "john_cracking": {
      "nombre": "John the Ripper - Cracking de Contraseñas",
      "descripcion": "Herramienta para descifrar contraseñas hasheadas",
      "categoria": "post_explotacion",
      "dificultad": "intermedio",
      "plataforma": "kali_linux",
      "comandos": [
        {
          "nombre": "Cracking básico",
          "comando": "john [archivo_hash]",
          "descripcion": "Inicia cracking con diccionario por defecto",
          "ejemplo": "john passwords.txt",
          "uso": "Descifrado básico de contraseñas"
        },
        {
          "nombre": "Usar diccionario personalizado",
          "comando": "john --wordlist=[diccionario] [archivo_hash]",
          "descripcion": "Utiliza diccionario específico para el ataque",
          "ejemplo": "john --wordlist=/usr/share/wordlists/rockyou.txt passwords.txt",
          "uso": "Ataque de diccionario personalizado"
        },
        {
          "nombre": "Mostrar contraseñas crackeadas",
          "comando": "john --show [archivo_hash]",
          "descripcion": "Muestra contraseñas ya descifradas",
          "ejemplo": "john --show passwords.txt",
          "uso": "Visualizar resultados del cracking"
        },
        {
          "nombre": "Extraer hash de shadow",
          "comando": "unshadow /etc/passwd /etc/shadow > hashes.txt",
          "descripcion": "Combina archivos passwd y shadow para John",
          "ejemplo": "unshadow /etc/passwd /etc/shadow > hashes.txt",
          "uso": "Preparar hashes del sistema para cracking"
        }
      ]
    },
    "wireshark_analisis": {
      "nombre": "Wireshark - Análisis de Tráfico",
      "descripcion": "Captura y análisis de paquetes de red",
      "categoria": "analisis_forense",
      "dificultad": "intermedio",
      "plataforma": "kali_linux",
      "comandos": [
        {
          "nombre": "Captura en línea de comandos",
          "comando": "tshark -i [interfaz]",
          "descripcion": "Captura tráfico en tiempo real desde terminal",
          "ejemplo": "tshark -i eth0",
          "uso": "Monitoreo de tráfico en tiempo real"
        },
        {
          "nombre": "Filtrar por protocolo",
          "comando": "tshark -i [interfaz] -f \"[protocolo]\"",
          "descripcion": "Captura solo tráfico del protocolo especificado",
          "ejemplo": "tshark -i eth0 -f \"tcp port 80\"",
          "uso": "Análisis de tráfico HTTP específico"
        },
        {
          "nombre": "Guardar captura",
          "comando": "tshark -i [interfaz] -w [archivo.pcap]",
          "descripcion": "Guarda captura en archivo para análisis posterior",
          "ejemplo": "tshark -i eth0 -w captura.pcap",
          "uso": "Almacenar evidencia de tráfico"
        },
        {
          "nombre": "Analizar archivo capturado",
          "comando": "tshark -r [archivo.pcap]",
          "descripcion": "Analiza archivo de captura previamente guardado",
          "ejemplo": "tshark -r captura.pcap",
          "uso": "Análisis forense de tráfico capturado"
        }
      ]
    },
    "volatility_memoria": {
      "nombre": "Volatility - Análisis de Memoria",
      "descripcion": "Framework para análisis forense de volcados de memoria",
      "categoria": "analisis_forense",
      "dificultad": "avanzado",
      "plataforma": "kali_linux",
      "comandos": [
        {
          "nombre": "Identificar perfil de imagen",
          "comando": "vol -f [imagen.mem] imageinfo",
          "descripcion": "Identifica el perfil del sistema operativo",
          "ejemplo": "vol -f memory.mem imageinfo",
          "uso": "Determinar perfil para análisis"
        },
        {
          "nombre": "Listar procesos",
          "comando": "vol -f [imagen.mem] --profile=[perfil] pslist",
          "descripcion": "Enumera procesos en ejecución en el momento del volcado",
          "ejemplo": "vol -f memory.mem --profile=Win7SP1x64 pslist",
          "uso": "Identificar procesos sospechosos"
        },
        {
          "nombre": "Buscar conexiones de red",
          "comando": "vol -f [imagen.mem] --profile=[perfil] netscan",
          "descripcion": "Muestra conexiones de red activas",
          "ejemplo": "vol -f memory.mem --profile=Win7SP1x64 netscan",
          "uso": "Detectar comunicaciones maliciosas"
        },
        {
          "nombre": "Extraer archivos",
          "comando": "vol -f [imagen.mem] --profile=[perfil] filescan",
          "descripcion": "Escanea archivos en memoria",
          "ejemplo": "vol -f memory.mem --profile=Win7SP1x64 filescan",
          "uso": "Recuperar evidencia de archivos"
        }
      ]
    },
    "tor_anonimato": {
      "nombre": "Tor - Navegación Anónima",
      "descripcion": "Configuración y uso de Tor para anonimato",
      "categoria": "anonimato_privacidad",
      "dificultad": "principiante",
      "plataforma": "kali_linux",
      "comandos": [
        {
          "nombre": "Instalar Tor",
          "comando": "apt update && apt install tor",
          "descripcion": "Instala el servicio Tor en Kali Linux",
          "ejemplo": "apt update && apt install tor",
          "uso": "Instalación inicial de Tor"
        },
        {
          "nombre": "Iniciar servicio Tor",
          "comando": "systemctl start tor",
          "descripcion": "Inicia el servicio de enrutamiento Tor",
          "ejemplo": "systemctl start tor",
          "uso": "Activar proxy Tor en el sistema"
        },
        {
          "nombre": "Verificar estado de Tor",
          "comando": "systemctl status tor",
          "descripcion": "Comprueba si el servicio Tor está funcionando",
          "ejemplo": "systemctl status tor",
          "uso": "Verificar funcionamiento del proxy"
        },
        {
          "nombre": "Usar proxy con curl",
          "comando": "curl --socks5 127.0.0.1:9050 [URL]",
          "descripcion": "Realiza peticiones web a través de Tor",
          "ejemplo": "curl --socks5 127.0.0.1:9050 https://check.torproject.org",
          "uso": "Navegación anónima desde terminal"
        }
      ]
    }
