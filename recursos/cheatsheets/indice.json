    "nmap_basico": {
      "nombre": "Nmap - Escaneo de Red Básico",
      "descripcion": "Comandos esenciales de Nmap para reconocimiento y escaneo de puertos",
      "categoria": "reconocimiento",
      "dificultad": "principiante",
      "plataforma": "kali_linux",
      "comandos": [
        {
          "nombre": "Escaneo básico de puertos",
          "comando": "nmap [IP_objetivo]",
          "descripcion": "Escanea los 1000 puertos más comunes",
          "ejemplo": "nmap 192.168.1.100",
          "uso": "Reconocimiento inicial de servicios"
        },
        {
          "nombre": "Escaneo completo de puertos",
          "comando": "nmap -p- [IP_objetivo]",
          "descripcion": "Escanea todos los 65535 puertos",
          "ejemplo": "nmap -p- 192.168.1.100",
          "uso": "Escaneo exhaustivo de puertos"
        },
        {
          "nombre": "Detección de servicios y versiones",
          "comando": "nmap -sV [IP_objetivo]",
          "descripcion": "Detecta versiones de servicios en puertos abiertos",
          "ejemplo": "nmap -sV 192.168.1.100",
          "uso": "Identificación de servicios vulnerables"
        },
        {
          "nombre": "Escaneo con scripts",
          "comando": "nmap -sC [IP_objetivo]",
          "descripcion": "Ejecuta scripts por defecto de reconocimiento",
          "ejemplo": "nmap -sC 192.168.1.100",
          "uso": "Reconocimiento automatizado"
        },
        {
          "nombre": "Escaneo agresivo",
          "comando": "nmap -A [IP_objetivo]",
          "descripcion": "Combina detección de SO, versiones, scripts y traceroute",
          "ejemplo": "nmap -A 192.168.1.100",
          "uso": "Reconocimiento completo del objetivo"
        }
      ]
    },
