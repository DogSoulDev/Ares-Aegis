{
  "metadatos": {
    "version": "1.0.0",
    "autor": "DogSoulDev",
    "descripcion": "Herramientas DevSecOps para integrar seguridad en CI/CD",
    "fecha_actualizacion": "2025-07-20"
  },
  "categorias": {
    "sast_tools": {
      "titulo": "🔍 SAST - Static Application Security Testing",
      "descripcion": "Herramientas de análisis estático de código",
      "herramientas": {
        "semgrep": {
          "descripcion": "Analizador estático multilenguaje",
          "comandos": [
            {
              "comando": "semgrep --config=auto .",
              "descripcion": "Escaneo automático del proyecto",
              "ejemplo": "semgrep --config=auto --json --output=results.json ."
            },
            {
              "comando": "semgrep --config=p/security-audit .",
              "descripcion": "Reglas específicas de seguridad",
              "ejemplo": "semgrep --config=p/owasp-top-ten ."
            },
            {
              "comando": "semgrep --config=r/java.lang.security .",
              "descripcion": "Reglas específicas por lenguaje",
              "ejemplo": "semgrep --config=r/python.flask.security ."
            }
          ]
        },
        "sonarqube": {
          "descripcion": "Plataforma de calidad y seguridad de código",
          "comandos": [
            {
              "comando": "sonar-scanner -Dsonar.projectKey=PROJECT -Dsonar.sources=.",
              "descripcion": "Escanear proyecto con SonarQube",
              "ejemplo": "sonar-scanner -Dsonar.projectKey=myapp -Dsonar.host.url=http://localhost:9000"
            }
          ]
        },
        "bandit": {
          "descripcion": "Herramienta SAST específica para Python",
          "comandos": [
            {
              "comando": "bandit -r /path/to/code",
              "descripcion": "Escanear recursivamente código Python",
              "ejemplo": "bandit -r ./src -f json -o bandit_report.json"
            },
            {
              "comando": "bandit -ll -i",
              "descripcion": "Solo vulnerabilidades de nivel medio y alto",
              "ejemplo": "bandit -r . -ll --exclude=./tests"
            }
          ]
        },
        "brakeman": {
          "descripcion": "Escáner de seguridad para Ruby on Rails",
          "comandos": [
            {
              "comando": "brakeman .",
              "descripcion": "Escanear aplicación Rails",
              "ejemplo": "brakeman --format json --output brakeman_report.json"
            }
          ]
        },
        "eslint_security": {
          "descripcion": "Plugin de seguridad para ESLint (JavaScript)",
          "comandos": [
            {
              "comando": "eslint --ext .js,.jsx --format json .",
              "descripcion": "Análisis de JavaScript con reglas de seguridad",
              "ejemplo": "eslint --config .eslintrc-security.js --format json ."
            }
          ]
        }
      }
    },
    "dast_tools": {
      "titulo": "🌐 DAST - Dynamic Application Security Testing",
      "descripcion": "Herramientas de análisis dinámico de aplicaciones",
      "herramientas": {
        "owasp_zap": {
          "descripcion": "Proxy de seguridad web OWASP",
          "comandos": [
            {
              "comando": "zap-baseline.py -t https://target.com",
              "descripcion": "Escaneo básico automatizado",
              "ejemplo": "zap-baseline.py -t https://app.example.com -J baseline_report.json"
            },
            {
              "comando": "zap-full-scan.py -t https://target.com",
              "descripcion": "Escaneo completo automatizado",
              "ejemplo": "zap-full-scan.py -t https://webapp.com -r full_scan_report.html"
            },
            {
              "comando": "zap.sh -daemon -port 8080 -config api.disablekey=true",
              "descripcion": "Iniciar ZAP en modo daemon",
              "ejemplo": "zap.sh -daemon -port 8090 -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true"
            }
          ]
        },
        "w3af": {
          "descripcion": "Framework de auditoría web",
          "comandos": [
            {
              "comando": "w3af_console",
              "descripcion": "Iniciar consola interactiva W3AF",
              "ejemplo": "w3af_console"
            }
          ]
        },
        "skipfish": {
          "descripcion": "Escáner web de reconocimiento activo",
          "comandos": [
            {
              "comando": "skipfish -o output_dir http://target.com",
              "descripcion": "Escaneo web completo",
              "ejemplo": "skipfish -o /tmp/skipfish_results -W /usr/share/skipfish/dictionaries/complete.wl http://webapp.local"
            }
          ]
        }
      }
    },
    "iast_tools": {
      "titulo": "🔬 IAST - Interactive Application Security Testing",
      "descripcion": "Herramientas de análisis interactivo durante runtime",
      "herramientas": {
        "contrast_security": {
          "descripcion": "Agente IAST para aplicaciones",
          "comandos": [
            {
              "comando": "java -javaagent:contrast.jar -jar app.jar",
              "descripcion": "Ejecutar aplicación Java con agente Contrast",
              "ejemplo": "java -javaagent:/opt/contrast/contrast.jar -jar myapp.jar"
            }
          ]
        },
        "hdiv": {
          "descripcion": "Protección runtime para aplicaciones web",
          "comandos": [
            {
              "comando": "# Configuración en aplicación web",
              "descripcion": "Integrar HDIV en aplicación Spring/Struts",
              "ejemplo": "# Ver documentación de HDIV para configuración"
            }
          ]
        }
      }
    },
    "dependency_scanning": {
      "titulo": "📦 Análisis de Dependencias",
      "descripcion": "Herramientas para detectar vulnerabilidades en librerías",
      "herramientas": {
        "snyk": {
          "descripcion": "Plataforma de seguridad para desarrolladores",
          "comandos": [
            {
              "comando": "snyk test",
              "descripcion": "Escanear dependencias del proyecto",
              "ejemplo": "snyk test --json > snyk_report.json"
            },
            {
              "comando": "snyk monitor",
              "descripcion": "Monitoreo continuo de vulnerabilidades",
              "ejemplo": "snyk monitor --project-name=my-app"
            },
            {
              "comando": "snyk code test",
              "descripcion": "Análisis estático de código con Snyk",
              "ejemplo": "snyk code test --json"
            }
          ]
        },
        "safety": {
          "descripcion": "Verificador de vulnerabilidades para Python",
          "comandos": [
            {
              "comando": "safety check",
              "descripcion": "Verificar vulnerabilidades en dependencias Python",
              "ejemplo": "safety check --json --output safety_report.json"
            },
            {
              "comando": "safety check -r requirements.txt",
              "descripcion": "Verificar archivo requirements específico",
              "ejemplo": "safety check -r requirements-prod.txt"
            }
          ]
        },
        "npm_audit": {
          "descripcion": "Auditoría de vulnerabilidades NPM",
          "comandos": [
            {
              "comando": "npm audit",
              "descripcion": "Auditar dependencias del proyecto Node.js",
              "ejemplo": "npm audit --json > npm_audit_report.json"
            },
            {
              "comando": "npm audit fix",
              "descripcion": "Intentar reparar vulnerabilidades automáticamente",
              "ejemplo": "npm audit fix --force"
            }
          ]
        },
        "bundle_audit": {
          "descripcion": "Auditoría de gemas Ruby",
          "comandos": [
            {
              "comando": "bundle audit",
              "descripcion": "Verificar vulnerabilidades en gemas Ruby",
              "ejemplo": "bundle audit --format json --output bundle_audit.json"
            },
            {
              "comando": "bundle audit update",
              "descripcion": "Actualizar base de datos de vulnerabilidades",
              "ejemplo": "bundle audit update"
            }
          ]
        },
        "retire_js": {
          "descripcion": "Detectar librerías JavaScript vulnerables",
          "comandos": [
            {
              "comando": "retire --js --jspath ./js",
              "descripcion": "Escanear archivos JavaScript",
              "ejemplo": "retire --js --outputformat json --outputpath retire_report.json"
            }
          ]
        }
      }
    },
    "secrets_scanning": {
      "titulo": "🔐 Detección de Secretos",
      "descripcion": "Herramientas para detectar credenciales hardcodeadas",
      "herramientas": {
        "truffleHog": {
          "descripcion": "Buscar secretos en repositorios Git",
          "comandos": [
            {
              "comando": "trufflehog git https://github.com/user/repo.git",
              "descripcion": "Escanear repositorio remoto",
              "ejemplo": "trufflehog git https://github.com/myorg/myapp.git --json"
            },
            {
              "comando": "trufflehog filesystem /path/to/code",
              "descripcion": "Escanear sistema de archivos local",
              "ejemplo": "trufflehog filesystem ./src --json > secrets_report.json"
            }
          ]
        },
        "git_secrets": {
          "descripcion": "Prevenir commits con secretos",
          "comandos": [
            {
              "comando": "git secrets --scan",
              "descripcion": "Escanear repositorio actual",
              "ejemplo": "git secrets --scan-history"
            },
            {
              "comando": "git secrets --install",
              "descripcion": "Instalar hooks de Git",
              "ejemplo": "git secrets --install ~/.git-templates/git-secrets"
            },
            {
              "comando": "git secrets --register-aws",
              "descripcion": "Registrar patrones AWS",
              "ejemplo": "git secrets --register-aws"
            }
          ]
        },
        "detect_secrets": {
          "descripcion": "Herramienta enterprise para detección de secretos",
          "comandos": [
            {
              "comando": "detect-secrets scan --all-files",
              "descripcion": "Escanear todos los archivos",
              "ejemplo": "detect-secrets scan --all-files > .secrets.baseline"
            },
            {
              "comando": "detect-secrets audit .secrets.baseline",
              "descripcion": "Auditar secretos encontrados",
              "ejemplo": "detect-secrets audit .secrets.baseline"
            }
          ]
        },
        "gitleaks": {
          "descripcion": "SAST para detectar secretos y claves",
          "comandos": [
            {
              "comando": "gitleaks detect --source=.",
              "descripcion": "Detectar secretos en código fuente",
              "ejemplo": "gitleaks detect --source=. --report-format=json --report-path=gitleaks_report.json"
            },
            {
              "comando": "gitleaks protect --staged",
              "descripcion": "Proteger contra commits con secretos",
              "ejemplo": "gitleaks protect --staged --verbose"
            }
          ]
        }
      }
    },
    "infrastructure_security": {
      "titulo": "🏗️ Seguridad de Infraestructura",
      "descripcion": "Herramientas para auditoría de Infrastructure as Code",
      "herramientas": {
        "terrascan": {
          "descripcion": "Analizador de seguridad para IaC",
          "comandos": [
            {
              "comando": "terrascan scan -t terraform",
              "descripcion": "Escanear archivos Terraform",
              "ejemplo": "terrascan scan -t terraform -d ./terraform --output json"
            },
            {
              "comando": "terrascan scan -t kubernetes",
              "descripcion": "Escanear manifiestos Kubernetes",
              "ejemplo": "terrascan scan -t kubernetes -f k8s-deployment.yaml"
            }
          ]
        },
        "tfsec": {
          "descripcion": "Analizador de seguridad específico para Terraform",
          "comandos": [
            {
              "comando": "tfsec .",
              "descripcion": "Escanear directorio Terraform actual",
              "ejemplo": "tfsec --format json --out tfsec_report.json ."
            },
            {
              "comando": "tfsec --exclude-downloaded-modules",
              "descripcion": "Excluir módulos descargados",
              "ejemplo": "tfsec --exclude-downloaded-modules --minimum-severity HIGH"
            }
          ]
        },
        "kube_score": {
          "descripcion": "Analizador de objetos Kubernetes",
          "comandos": [
            {
              "comando": "kube-score score deployment.yaml",
              "descripcion": "Evaluar configuración Kubernetes",
              "ejemplo": "kube-score score *.yaml --output-format json"
            }
          ]
        },
        "hadolint": {
          "descripcion": "Linter para Dockerfiles",
          "comandos": [
            {
              "comando": "hadolint Dockerfile",
              "descripcion": "Analizar Dockerfile",
              "ejemplo": "hadolint --format json Dockerfile > hadolint_report.json"
            }
          ]
        }
      }
    },
    "ci_cd_integration": {
      "titulo": "🔄 Integración CI/CD",
      "descripcion": "Comandos para integrar herramientas en pipelines",
      "herramientas": {
        "github_actions": {
          "descripcion": "Configuración para GitHub Actions",
          "comandos": [
            {
              "comando": "# .github/workflows/security.yml",
              "descripcion": "Ejemplo de workflow de seguridad",
              "ejemplo": "# Ver documentación de GitHub Actions para sintaxis YAML"
            }
          ]
        },
        "gitlab_ci": {
          "descripcion": "Configuración para GitLab CI",
          "comandos": [
            {
              "comando": "# .gitlab-ci.yml",
              "descripcion": "Ejemplo de pipeline con análisis de seguridad",
              "ejemplo": "# include: template: Security/SAST.gitlab-ci.yml"
            }
          ]
        },
        "jenkins": {
          "descripcion": "Plugins de seguridad para Jenkins",
          "comandos": [
            {
              "comando": "# Pipeline script",
              "descripcion": "Ejemplo de pipeline Jenkins con security scanning",
              "ejemplo": "# stage('Security Scan') { steps { sh 'semgrep --config=auto .' } }"
            }
          ]
        },
        "azure_devops": {
          "descripcion": "Configuración para Azure DevOps",
          "comandos": [
            {
              "comando": "# azure-pipelines.yml",
              "descripcion": "Ejemplo de pipeline Azure con análisis",
              "ejemplo": "# - task: SonarQubePrepare@4"
            }
          ]
        }
      }
    },
    "compliance": {
      "titulo": "📋 Compliance y Governance",
      "descripcion": "Herramientas para cumplimiento y governance",
      "herramientas": {
        "open_policy_agent": {
          "descripcion": "Motor de políticas unificado",
          "comandos": [
            {
              "comando": "opa test policy/",
              "descripcion": "Probar políticas OPA",
              "ejemplo": "opa test --verbose policy/"
            },
            {
              "comando": "opa eval -d policy/ -i input.json 'data.main.allow'",
              "descripcion": "Evaluar política con input",
              "ejemplo": "opa eval -d ./policies -i request.json 'data.kubernetes.admission.deny[_]'"
            }
          ]
        },
        "conftest": {
          "descripcion": "Testing de configuraciones con OPA",
          "comandos": [
            {
              "comando": "conftest test --policy policy/ configs/",
              "descripcion": "Probar configuraciones contra políticas",
              "ejemplo": "conftest test --policy ./policies docker-compose.yml"
            }
          ]
        },
        "inspec": {
          "descripcion": "Framework de compliance testing",
          "comandos": [
            {
              "comando": "inspec exec profile/",
              "descripcion": "Ejecutar perfil de compliance",
              "ejemplo": "inspec exec https://github.com/dev-sec/linux-baseline"
            }
          ]
        }
      }
    },
    "monitoring": {
      "titulo": "📊 Monitoreo de Seguridad",
      "descripcion": "Herramientas para monitoreo continuo de seguridad",
      "herramientas": {
        "falco": {
          "descripcion": "Runtime security monitoring para Kubernetes",
          "comandos": [
            {
              "comando": "falco -r /etc/falco/falco_rules.yaml",
              "descripcion": "Iniciar Falco con reglas personalizadas",
              "ejemplo": "falco -M 45 -r custom_rules.yaml"
            }
          ]
        },
        "prometheus": {
          "descripcion": "Métricas de seguridad con Prometheus",
          "comandos": [
            {
              "comando": "prometheus --config.file=prometheus.yml",
              "descripcion": "Iniciar Prometheus con configuración",
              "ejemplo": "prometheus --config.file=/etc/prometheus/prometheus.yml"
            }
          ]
        },
        "grafana": {
          "descripcion": "Dashboards de seguridad",
          "comandos": [
            {
              "comando": "grafana-server --config=/etc/grafana/grafana.ini",
              "descripcion": "Iniciar servidor Grafana",
              "ejemplo": "grafana-server --homepath=/usr/share/grafana"
            }
          ]
        }
      }
    }
  }
}
