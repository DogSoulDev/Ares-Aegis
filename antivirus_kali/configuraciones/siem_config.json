{
  "database": {
    "path": "siem_events.db",
    "retention_days": 30,
    "batch_size": 100
  },
  "collection": {
    "poll_interval": 1,
    "sources": [
      "/var/log/auth.log",
      "/var/log/syslog",
      "/var/log/dpkg.log"
    ]
  },
  "notifications": {
    "desktop": true,
    "terminal": true,
    "log_file": true
  }
}