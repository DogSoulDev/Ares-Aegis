    "herramientas_kali": {
        "gobuster": {
            "descripcion": "Herramienta de fuzzing rápida escrita en Go",
            "instalacion": "apt install gobuster",
            "modos": ["dir", "dns", "vhost"],
            "wordlists_compatibles": ["seclists_directories.txt", "seclists_subdomains.txt"],
            "ejemplos_uso": [
                "gobuster dir -u http://target.com -w seclists_directories.txt -x php,html,txt",
                "gobuster dns -d target.com -w seclists_subdomains.txt",
                "gobuster vhost -u http://target.com -w seclists_subdomains.txt"
            ]
        },
        "ffuf": {
            "descripcion": "Fast web fuzzer escrito en Go",
            "instalacion": "apt install ffuf",
            "wordlists_compatibles": ["seclists_directories.txt", "api_endpoints.txt", "web_extensions.txt"],
            "ejemplos_uso": [
                "ffuf -u http://target.com/FUZZ -w seclists_directories.txt",
                "ffuf -u http://target.com/FUZZ.FUZ2Z -w seclists_directories.txt:FUZZ -w web_extensions.txt:FUZ2Z",
                "ffuf -u https://FUZZ.target.com -w seclists_subdomains.txt"
            ]
        },
        "hydra": {
            "descripcion": "Herramienta de fuerza bruta para múltiples protocolos",
            "instalacion": "apt install hydra",
            "protocolos": ["ssh", "ftp", "http", "https", "smb", "pop3", "imap"],
            "wordlists_compatibles": ["seclists_usernames.txt", "rockyou_top10k.txt", "passwords_worst_500.txt"],
            "ejemplos_uso": [
                "hydra -L seclists_usernames.txt -P rockyou_top10k.txt ssh://target.com",
                "hydra -l admin -P passwords_worst_500.txt http-post-form '/login:username=^USER^&password=^PASS^:Invalid'",
                "hydra -L seclists_usernames.txt -P rockyou_top10k.txt ftp://target.com"
            ]
        },
        "wfuzz": {
            "descripcion": "Web application fuzzer flexible",
            "instalacion": "apt install wfuzz",
            "wordlists_compatibles": ["seclists_directories.txt", "api_endpoints.txt"],
            "ejemplos_uso": [
                "wfuzz -c -z file,seclists_directories.txt http://target.com/FUZZ",
                "wfuzz -c -z file,api_endpoints.txt -z file,web_extensions.txt http://target.com/FUZZ.FUZ2Z"
            ]
        },
        "john": {
            "descripcion": "John the Ripper - Crackeador de contraseñas",
            "instalacion": "apt install john",
            "wordlists_compatibles": ["rockyou_top10k.txt", "passwords_worst_500.txt", "combinaciones_basicas.txt"],
            "ejemplos_uso": [
                "john --wordlist=rockyou_top10k.txt hashes.txt",
                "john --wordlist=passwords_worst_500.txt --rules hashes.txt"
            ]
        },
        "hashcat": {
            "descripcion": "Avanzado crackeador de contraseñas",
            "instalacion": "apt install hashcat",
            "wordlists_compatibles": ["rockyou_top10k.txt", "passwords_worst_500.txt"],
            "ejemplos_uso": [
                "hashcat -m 0 -a 0 hashes.txt rockyou_top10k.txt",
                "hashcat -m 1000 -a 0 hashes.txt passwords_worst_500.txt"
            ]
        }
    },
